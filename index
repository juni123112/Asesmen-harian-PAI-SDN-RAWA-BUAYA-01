        /* Export CSV */
        function exportResultsCSV() {
            if (examResultsHistory.length === 0) {
                alert("Belum ada data nilai ujian untuk diunduh!");
                return;
            }

            let csv = "No,Nama Siswa,Kelas,Skor,Pelanggaran,Waktu Pengerjaan,Timestamp\n";
            examResultsHistory.forEach((res, i) => {
                csv += `"${i+1}","${res.nama}","${res.kelas}","${res.skor}","${res.pelanggaran}","${res.waktu}","${res.timestamp}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `Rekap_Nilai_PAI_SDN_Rawa_Buaya_01.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

