            if (examResultsHistory.length === 0) {
                alert("Belum ada data nilai ujian untuk diekspor!");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            // Document Header
            doc.setFontSize(14);
            doc.setFont("helvetica", "bold");
            doc.text("SDN RAWA BUAYA 01", 105, 15, { align: "center" });
            doc.setFontSize(12);
            doc.text("REKAPITULASI HASIL ASESMEN HARIAN PAI", 105, 22, { align: "center" });
            doc.setFontSize(10);
            doc.setFont("helvetica", "normal");
            doc.text("Guru Pengampu: Junialdi, S.Pd, Gr.", 105, 28, { align: "center" });
            doc.line(14, 32, 196, 32);

            // Table Data
            const tableData = examResultsHistory.map((res, i) => [
                i + 1,
                res.nama,
                `Kelas ${res.kelas.toUpperCase()}`,
                res.skor,
                `${res.pelanggaran} kali`,
                res.timestamp
            ]);

            doc.autoTable({
                startY: 36,
                head: [['No', 'Nama Siswa', 'Kelas', 'Skor', 'Pelanggaran', 'Waktu']],
                body: tableData,
                theme: 'striped',
                headStyles: { fillColor: [21, 128, 61] }
            });

            const finalY = doc.lastAutoTable.finalY + 15;
            doc.text("Jakarta, " + new Date().toLocaleDateString('id-ID'), 140, finalY);
            doc.text("Guru PAI SDN Rawa Buaya 01", 140, finalY + 6);
            doc.setFont("helvetica", "bold");
            doc.text("Junialdi, S.Pd, Gr.", 140, finalY + 25);

            doc.save("Laporan_Nilai_PAI_SDN_Rawa_Buaya_01.pdf");
        }

        /* ================= QUESTION MANAGEMENT & TEMPLATE ================= */
