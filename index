        function updateExamTimer() {
            if (!isExamActive) return;
            examTimeRemaining--;

            if (examTimeRemaining <= 0) {
                clearInterval(examTimerInterval);
                alert("Waktu ujian telah habis! Jawaban Anda otomatis terkirim.");
                autoSubmitExam();
                return;
            }

            const mins = Math.floor(examTimeRemaining / 60);
            const secs = examTimeRemaining % 60;
            document.getElementById('examTimer').textContent = 
                `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function loadQuestion(index) {
            const q = questionsBank[index];
            if (!q) return;

            // Check if subtest transition pause is required
            const currentSubtest = q.type;
            if (!visitedSubtests.has(currentSubtest)) {
                // Trigger 1 Minute Pause Transition
                triggerTransitionPause(currentSubtest, () => {
                    visitedSubtests.add(currentSubtest);
                    currentQuestionIndex = index;
                    renderQuestionContent(q, index);
                });
                return;
            }

            currentQuestionIndex = index;
            renderQuestionContent(q, index);
        }

        function renderQuestionContent(q, index) {
            document.getElementById('questionNumBadge').textContent = `Soal #${index + 1} dari ${questionsBank.length}`;
            document.getElementById('questionTypeLabel').textContent = SUBTEST_LABELS[q.type] || q.type;
            document.getElementById('examQuestionTypeTag').textContent = `Sub-Tes: ${SUBTEST_LABELS[q.type]}`;
            document.getElementById('questionText').textContent = q.text;

            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            const currentAns = studentAnswers[q.id];

            if (q.type === 'PG' || q.type === 'BS') {
                q.options.forEach((opt) => {
                    const label = document.createElement('label');
                    const isChecked = currentAns === opt;
                    label.className = `flex items-center p-3.5 rounded-xl border-2 cursor-pointer transition ${isChecked ? 'bg-emerald-50 border-islamic-600 font-semibold' : 'bg-slate-50 border-slate-200 hover:bg-slate-100'}`;
                    
                    label.innerHTML = `
                        <input type="radio" name="q_${q.id}" value="${opt}" ${isChecked ? 'checked' : ''} onchange="saveAnswer(${q.id}, '${opt}')" class="w-4 h-4 text-islamic-600 focus:ring-islamic-500">
                        <span class="ml-3 text-sm text-slate-800">${opt}</span>
                    `;
                    container.appendChild(label);
                });
            } else if (q.type === 'PGK') {
                const selectedArr = Array.isArray(currentAns) ? currentAns : [];
                q.options.forEach((opt) => {
                    const label = document.createElement('label');
                    const isChecked = selectedArr.includes(opt);
                    label.className = `flex items-center p-3.5 rounded-xl border-2 cursor-pointer transition ${isChecked ? 'bg-emerald-50 border-islamic-600 font-semibold' : 'bg-slate-50 border-slate-200 hover:bg-slate-100'}`;
                    
                    label.innerHTML = `
                        <input type="checkbox" value="${opt}" ${isChecked ? 'checked' : ''} onchange="saveAnswerPGK(${q.id}, '${opt}')" class="w-4 h-4 text-islamic-600 rounded focus:ring-islamic-500">
                        <span class="ml-3 text-sm text-slate-800">${opt}</span>
                    `;
                    container.appendChild(label);
                });
            } else if (q.type === 'IS' || q.type === 'UT') {
                const val = currentAns || '';
                const isEssay = q.type === 'UT';
                
                if (isEssay) {
                    container.innerHTML = `
                        <textarea rows="4" placeholder="Tuliskan jawaban uraian Anda di sini dengan jelas..." oninput="saveAnswer(${q.id}, this.value)" class="w-full p-3 bg-slate-50 border border-slate-300 rounded-xl text-sm outline-none focus:ring-2 focus:ring-islamic-500 focus:bg-white">${val}</textarea>
                    `;
                } else {
                    container.innerHTML = `
                        <input type="text" placeholder="Ketik jawaban singkat Anda..." value="${val}" oninput="saveAnswer(${q.id}, this.value)" class="w-full p-3 bg-slate-50 border border-slate-300 rounded-xl text-sm outline-none focus:ring-2 focus:ring-islamic-500 focus:bg-white">
                    `;
                }
            }

            // Update Doubt Flag Button State
            const isDoubt = !!doubtStatus[q.id];
            const doubtBtn = document.getElementById('btnDoubt');
            if (isDoubt) {
                doubtBtn.className = "px-4 py-2.5 bg-amber-500 text-white font-bold text-sm rounded-xl transition flex items-center space-x-2";
                document.getElementById('doubtBtnText').textContent = "Ragu-Ragu (Aktif)";
            } else {
                doubtBtn.className = "px-4 py-2.5 bg-amber-100 hover:bg-amber-200 text-amber-800 text-sm font-semibold rounded-xl transition flex items-center space-x-2";
                document.getElementById('doubtBtnText').textContent = "Ragu-Ragu";
            }

            // Prev & Next Button State
            document.getElementById('btnPrev').disabled = (index === 0);
            if (index === 0) {
                document.getElementById('btnPrev').classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                document.getElementById('btnPrev').classList.remove('opacity-50', 'cursor-not-allowed');
            }

            if (index === questionsBank.length - 1) {
                document.getElementById('btnNext').classList.add('hidden');
                document.getElementById('btnFinishExam').classList.remove('hidden');
            } else {
                document.getElementById('btnNext').classList.remove('hidden');
                document.getElementById('btnFinishExam').classList.add('hidden');
            }

            renderQuestionGrid();
        }

        function saveAnswer(qId, value) {
            studentAnswers[qId] = value;
            renderQuestionGrid();
        }

        function saveAnswerPGK(qId, opt) {
            let current = studentAnswers[qId] || [];
            if (!Array.isArray(current)) current = [];

            if (current.includes(opt)) {
                current = current.filter(x => x !== opt);
            } else {
                current.push(opt);
            }
            studentAnswers[qId] = current;
            renderQuestionGrid();
        }

        function toggleDoubt() {
            const q = questionsBank[currentQuestionIndex];
            if (!q) return;
            doubtStatus[q.id] = !doubtStatus[q.id];
            loadQuestion(currentQuestionIndex);
        }

        function navigateQuestion(direction) {
            const nextIdx = currentQuestionIndex + direction;
            if (nextIdx >= 0 && nextIdx < questionsBank.length) {
                loadQuestion(nextIdx);
            }
        }

        function renderQuestionGrid() {
            const grid = document.getElementById('questionGrid');
            grid.innerHTML = '';
            let answeredCount = 0;

            questionsBank.forEach((q, idx) => {
                const btn = document.createElement('button');
                const ans = studentAnswers[q.id];
                const isAnswered = ans !== undefined && ans !== '' && (!Array.isArray(ans) || ans.length > 0);
                const isDoubt = !!doubtStatus[q.id];
                const isCurrent = (idx === currentQuestionIndex);

                if (isAnswered) answeredCount++;

                let bgClass = "bg-slate-100 text-slate-700 hover:bg-slate-200";
                if (isDoubt) {
                    bgClass = "bg-amber-400 text-slate-900 font-bold";
                } else if (isAnswered) {
                    bgClass = "bg-islamic-600 text-white font-bold";
                }

                btn.className = `h-9 rounded-lg font-bold text-xs transition flex items-center justify-center border-2 ${isCurrent ? 'border-amber-400 ring-2 ring-amber-300' : 'border-transparent'} ${bgClass}`;
                btn.textContent = idx + 1;
                btn.onclick = () => loadQuestion(idx);
                grid.appendChild(btn);
            });

            document.getElementById('answeredCounter').textContent = `${answeredCount}/${questionsBank.length} Terjawab`;
        }

        function triggerTransitionPause(nextType, onCompleteCallback) {
            const modal = document.getElementById('modalTransition');
            document.getElementById('nextSubtestTitle').textContent = SUBTEST_LABELS[nextType] || nextType;
            modal.classList.remove('hidden');

            let timeLeft = 60; // 1 minute pause requirement
            const cdEl = document.getElementById('transitionCountdown');
            const btnSkip = document.getElementById('btnSkipTransition');

            btnSkip.disabled = true;
            btnSkip.className = "w-full py-2.5 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed transition";
            btnSkip.textContent = "Menunggu Sisa Waktu Jedah (60s)...";

            clearInterval(transitionTimerInterval);
            transitionTimerInterval = setInterval(() => {
                timeLeft--;
                cdEl.textContent = `00:${timeLeft.toString().padStart(2, '0')}`;
                btnSkip.textContent = `Menunggu Sisa Waktu Jedah (${timeLeft}s)...`;

                if (timeLeft <= 0) {
                    clearInterval(transitionTimerInterval);
                    btnSkip.disabled = false;
                    btnSkip.className = "w-full py-2.5 bg-islamic-600 hover:bg-islamic-700 text-white font-bold text-xs rounded-xl shadow transition";
                    btnSkip.textContent = "Lanjut Ke Sub-Tes Berikutnya";
                }
            }, 1000);

            window.pendingTransitionCallback = () => {
                modal.classList.add('hidden');
                onCompleteCallback();
            };
        }

        function closeTransitionModal() {
            if (window.pendingTransitionCallback) {
                window.pendingTransitionCallback();
                window.pendingTransitionCallback = null;
            }
        }

        /* ================= ANTI CHEATING DETECTOR ================= */
        function setupAntiCheat() {
            const triggerWarning = () => {
                if (!isExamActive) return;

                cheatViolations++;
                updateCheatBadge();

                if (cheatViolations >= 3) {
                    document.getElementById('modalCheatWarning').classList.add('hidden');
                    alert("Sistem Mencegah Kecurangan: Anda telah keluar dari ujian sebanyak 3 kali! Ujian otomatis diselesaikan.");
                    autoSubmitExam();
                } else {
                    document.getElementById('modalCheatCountText').textContent = cheatViolations;
                    document.getElementById('modalCheatWarning').classList.remove('hidden');
                }
            };

            window.addEventListener('blur', triggerWarning);
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    triggerWarning();
                }
            });
        }

        function updateCheatBadge() {
            document.getElementById('cheatCountText').textContent = `${cheatViolations}/3`;
        }

        function dismissCheatWarning() {
            document.getElementById('modalCheatWarning').classList.add('hidden');
        }

        /* ================= EXAM FINISH & SCORING ================= */
        function confirmFinishExam() {
            let unanswered = 0;
            questionsBank.forEach(q => {
                const ans = studentAnswers[q.id];
                if (ans === undefined || ans === '' || (Array.isArray(ans) && ans.length === 0)) {
                    unanswered++;
                }
            });

            let msg = "Apakah Anda yakin ingin menyelesaikan ujian ini?";
            if (unanswered > 0) {
                msg = `Perhatian: Masih ada ${unanswered} soal yang belum Anda jawab! Yakin ingin menyelesaikan ujian?`;
            }

            if (confirm(msg)) {
                autoSubmitExam();
            }
        }

        function autoSubmitExam() {
            isExamActive = false;
            clearInterval(examTimerInterval);

            // Calculate Score
            let correctCount = 0;
            let totalPoints = 0;

            questionsBank.forEach(q => {
                const studentAns = studentAnswers[q.id];
                if (!studentAns) return;

                if (q.type === 'PG' || q.type === 'BS') {
                    if (studentAns === q.correct) correctCount++;
                } else if (q.type === 'PGK') {
                    if (Array.isArray(studentAns) && Array.isArray(q.correct)) {
                        const isSame = studentAns.length === q.correct.length && 
                                       studentAns.every(val => q.correct.includes(val));
                        if (isSame) correctCount++;
                    }
                } else if (q.type === 'IS') {
                    if (studentAns.toString().trim().toLowerCase() === q.correct.toString().trim().toLowerCase()) {
                        correctCount++;
                    }
                } else if (q.type === 'UT') {
                    // Basic keyword matching for essay auto-score simulator
                    if (studentAns.toString().trim().length >= 10) {
                        correctCount += 0.8;
                    }
                }
            });

            const finalScore = Math.min(100, Math.round((correctCount / questionsBank.length) * 100));
            const timeTakenMins = Math.ceil((3600 - examTimeRemaining) / 60);

            const resultObj = {
                id: 'RES-' + Date.now(),
                nama: currentStudent.nama,
                kelas: currentStudent.kelas,
                skor: finalScore,
                pelanggaran: cheatViolations,
                waktu: `${timeTakenMins} Menit`,
                status: finalScore >= 75 ? "LULUS (Sangat Baik)" : "TETAP SEMANGAT",
                timestamp: new Date().toLocaleString('id-ID')
            };

            examResultsHistory.unshift(resultObj);
            renderResultsTable();

            // Render Result Card
            document.getElementById('resNama').textContent = currentStudent.nama;
            document.getElementById('resKelas').textContent = `Kelas ${currentStudent.kelas.toUpperCase()}`;
            document.getElementById('resWaktu').textContent = `${timeTakenMins} Menit`;
            document.getElementById('resViolations').textContent = cheatViolations > 0 ? `${cheatViolations} kali diperingatkan` : "0 kali (Sangat Jujur & Disiplin)";
            document.getElementById('resScore').textContent = finalScore;
            document.getElementById('resGradeStatus').textContent = finalScore >= 80 ? "Predikat: Sangat Baik (A)" : (finalScore >= 70 ? "Predikat: Baik (B)" : "Predikat: Cukup (C)");

            hideAllViews();
            document.getElementById('viewResult').classList.remove('hidden');
        }

