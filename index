        function handleUploadQuestions() {
            const fileInput = document.getElementById('questionFileInput');
            if (!fileInput.files.length) {
                alert("Silakan pilih file soal terlebih dahulu!");
                return;
            }

            const targetClass = document.getElementById('uploadClassTarget').value;
            alert(`Paket soal berhasil diunggah dan disimpan untuk ${targetClass}! (Total 30 Soal ter-update)`);
            renderQuestionBankPreview();
        }

        function renderQuestionBankPreview() {
            const list = document.getElementById('questionListPreview');
            list.innerHTML = '';
            document.getElementById('totalActiveQuestionsCount').textContent = questionsBank.length;

            questionsBank.forEach((q, i) => {
                const item = document.createElement('div');
                item.className = "p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between text-xs";
                item.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <span class="font-mono bg-islamic-100 text-islamic-800 font-bold px-2 py-0.5 rounded">#${i+1} [${q.type}]</span>
                        <span class="text-slate-800 font-medium truncate max-w-xs sm:max-w-md">${q.text}</span>
                    </div>
                    <span class="text-slate-400 font-semibold">Kunci: ${Array.isArray(q.correct) ? q.correct.join(', ') : q.correct}</span>
                `;
                list.appendChild(item);
            });
        }

        /* ================= STUDENT ROSTER MANAGEMENT ================= */
        function renderStudentManagementTable() {
            const tbody = document.getElementById('studentManageTableBody');
            tbody.innerHTML = '';

            const query = document.getElementById('searchStudentManage')?.value.toLowerCase() || '';
            const clsFilter = document.getElementById('filterClassManage')?.value.toLowerCase() || '';

            const filtered = activeStudents.filter(s => {
                const matchName = s.name.toLowerCase().includes(query);
                const matchClass = !clsFilter || s.class.toLowerCase() === clsFilter;
                return matchName && matchClass;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400 italic">Data siswa tidak ditemukan.</td></tr>`;
                return;
            }

            filtered.forEach((s, i) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-3 font-mono text-slate-400">${i + 1}</td>
                    <td class="p-3 font-bold text-slate-800">${s.name}</td>
                    <td class="p-3"><span class="bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded text-[11px]">Kelas ${s.class.toUpperCase()}</span></td>
                    <td class="p-3 text-right">
                        <button onclick="deleteStudent('${s.id}')" class="px-2 py-1 bg-red-100 hover:bg-red-200 text-red-700 text-[11px] font-bold rounded transition">
                            <i class="fa-solid fa-trash me-1"></i>Hapus
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function openAddStudentModal() {
            document.getElementById('modalAddStudent').classList.remove('hidden');
        }

        function closeAddStudentModal() {
            document.getElementById('modalAddStudent').classList.add('hidden');
        }

        function handleSaveNewStudent(e) {
            e.preventDefault();
            const name = document.getElementById('newStudentName').value.trim();
            const cls = document.getElementById('newStudentClass').value;

            if (!name || !cls) return;

            activeStudents.push({
                id: 'S-' + Date.now(),
                name,
                class: cls
            });

            document.getElementById('newStudentName').value = '';
            closeAddStudentModal();
            renderStudentManagementTable();
        }

        function deleteStudent(id) {
            if (confirm("Yakin ingin menghapus data siswa ini?")) {
                activeStudents = activeStudents.filter(s => s.id !== id);
                renderStudentManagementTable();
            }
        }

        /* Settings Logic */
        function saveExamToken() {
            const token = document.getElementById('teacherTokenInput').value.trim();
            if (!token) {
                alert("Token tidak boleh kosong!");
                return;
            }
            currentExamToken = token;
            alert(`Token Ujian berhasil diperbarui menjadi: ${token}`);
        }

        function copyGasCode() {
            const code = document.getElementById('gasCodeSnippet').textContent;
            navigator.clipboard.writeText(code).then(() => {
                alert("Kode Google Apps Script berhasil disalin ke clipboard!");
            });
        }
    </script>
