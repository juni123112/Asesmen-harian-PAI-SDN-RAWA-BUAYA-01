        function filterResultsTable() {
            const query = document.getElementById('searchStudentInput').value.toLowerCase();
            const cls = document.getElementById('filterClassSelect').value.toLowerCase();
            const rows = document.querySelectorAll('#resultsTableBody tr');

            rows.forEach(row => {
                const nameText = row.children[1]?.textContent.toLowerCase() || '';
                const classText = row.children[2]?.textContent.toLowerCase() || '';

                const matchesName = nameText.includes(query);
                const matchesClass = !cls || classText.includes(cls);

                if (matchesName && matchesClass) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

