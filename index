<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ASESMEN HARIAN PAI SDN RAWA BUAYA 01</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Amiri (Arabic) & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SheetJS (XLSX) for Excel Template generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- jsPDF & AutoTable for printing reports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        islamic: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#16a34a',
                            600: '#15803d',
                            700: '#166534',
                            800: '#14532d',
                            900: '#064e3b',
                            gold: '#d97706',
                            goldlight: '#fef3c7'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        arabic: ['Amiri', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        .arabic-text {
            font-family: 'Amiri', serif;
            direction: rtl;
        }
        .bg-islamic-pattern {
            background-color: #f8fafc;
            background-image: radial-gradient(#15803d 0.5px, transparent 0.5px), radial-gradient(#15803d 0.5px, #f8fafc 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            background-opacity: 0.05;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
        }
        .warning-pulse {
            animation: pulse-ring 2s infinite;
        }
    </style>
</head>
<body class="bg-slate-50 font-sans min-h-screen flex flex-col text-slate-800 bg-islamic-pattern select-none">

    <!-- HEADER BAR -->
    <header class="bg-gradient-to-r from-islamic-900 via-islamic-800 to-islamic-900 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-white p-1 rounded-full shadow-md flex items-center justify-center w-12 h-12 overflow-hidden border-2 border-amber-400">
                    <img src="https://iili.io/CSA5FBn.md.png" alt="Logo SDN Rawa Buaya 01" class="w-full h-full object-contain" onerror="this.src='https://placehold.co/100x100/166534/ffffff?text=SDN+01'">
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold tracking-tight text-amber-300 leading-tight">ASESMEN HARIAN PAI</h1>
                    <p class="text-xs sm:text-sm text-emerald-100 font-medium">SDN RAWA BUAYA 01 &bull; <span class="text-amber-200">Junialdi, S.Pd, Gr.</span></p>
                </div>
            </div>
            
            <div id="headerRightInfo" class="hidden sm:flex items-center space-x-3">
                <div class="text-right">
                    <span id="headerClock" class="text-xs font-mono bg-islamic-900/60 px-3 py-1 rounded-full border border-emerald-500/30 text-emerald-200">00:00:00 WIB</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-3 sm:p-6 flex flex-col justify-center">

        <!-- AYAT/HADITS KEJUJURAN CARD -->
        <div id="hadithCard" class="mb-6 bg-gradient-to-r from-emerald-900/90 to-islamic-800 text-white rounded-2xl p-4 sm:p-5 shadow-md border border-emerald-600/30 relative overflow-hidden transition-all duration-300">
            <div class="absolute -right-6 -bottom-6 text-white/5 text-8xl pointer-events-none">
                <i class="fa-solid me-1 fa-kaaba"></i>
            </div>
            <div class="relative z-10">
                <div class="flex items-center space-x-2 text-amber-300 font-semibold text-xs sm:text-sm mb-2">
                    <i class="fa-solid fa-book-quran"></i>
                    <span>Peringatan Mutiara Hadits &amp; Qur'an Tentang Kejujuran</span>
                </div>
                <div class="text-right my-2">
                    <p class="arabic-text text-xl sm:text-2xl font-bold text-amber-200 leading-loose">
                        يٰٓاَيُّهَا الَّذِيْنَ اٰمَنُوا اتَّقُوا اللّٰهَ وَكُوْنُوْا مَعَ الصّٰدِقِيْنَ
                    </p>
                </div>
                <p class="text-xs sm:text-sm text-emerald-50 italic mt-1 bg-black/20 p-2.5 rounded-lg border border-white/10">
                    "Wahai orang-orang yang beriman! Bertakwalah kepada Allah, dan bersamalah kamu dengan orang-orang yang jujur." <span class="font-semibold text-amber-300">(Q.S. At-Tawbah: 119)</span>
                </p>
            </div>
        </div>

        <!-- ================= VIEW 1: AUTH / LOGIN DASHBOARD ================= -->
        <div id="viewLogin" class="w-full max-w-xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200 transition-all duration-300">
            <!-- Role Switch Tabs -->
            <div class="flex border-b border-slate-200 bg-slate-100/80">
                <button id="tabSiswaBtn" onclick="switchLoginRole('siswa')" class="flex-1 py-3.5 px-4 text-center font-bold text-sm sm:text-base transition-all flex items-center justify-center space-x-2 text-islamic-700 bg-white border-b-2 border-islamic-600 shadow-sm">
                    <i class="fa-solid fa-user-graduate"></i>
                    <span>Portal Siswa</span>
                </button>
                <button id="tabGuruBtn" onclick="switchLoginRole('guru')" class="flex-1 py-3.5 px-4 text-center font-bold text-sm sm:text-base transition-all flex items-center justify-center space-x-2 text-slate-500 hover:text-slate-700">
                    <i class="fa-solid fa-user-tie"></i>
                    <span>Portal Guru</span>
                </button>
            </div>

            <div class="p-6 sm:p-8">
                <!-- FORM LOGIN SISWA -->
                <form id="formLoginSiswa" onsubmit="handleLoginSiswa(event)" class="space-y-4">
                    <div class="text-center mb-4">
                        <h2 class="text-xl font-bold text-slate-800">Masuk Ujian Siswa</h2>
                        <p class="text-xs text-slate-500 mt-1">Isi data diri dan token ujian dengan teliti</p>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Nama Lengkap</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input type="text" id="siswaNama" required placeholder="Contoh: Muhammad Ahmad" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-islamic-500 focus:bg-white text-sm outline-none transition">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Pilih Kelas</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-solid fa-school"></i>
                            </span>
                            <select id="siswaKelas" required class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-islamic-500 focus:bg-white text-sm outline-none transition appearance-none">
                                <option value="">-- Pilih Kelas Anda --</option>
                                <!-- JS will populate 1a to 6d -->
                            </select>
                            <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
                                <i class="fa-solid fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Token / Kata Kunci Ujian</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-solid fa-key"></i>
                            </span>
                            <input type="password" id="siswaToken" required placeholder="Masukkan Token Ujian" class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-islamic-500 focus:bg-white text-sm outline-none transition">
                            <button type="button" onclick="togglePasswordVisibility('siswaToken', 'toggleIconSiswa')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
                                <i id="toggleIconSiswa" class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1 italic">*Minta token ujian kepada Bapak Junialdi, S.Pd, Gr.</p>
                    </div>

                    <button type="submit" class="w-full mt-4 py-3 px-4 bg-gradient-to-r from-islamic-600 to-islamic-700 hover:from-islamic-700 hover:to-islamic-800 text-white font-bold rounded-xl shadow-lg shadow-islamic-600/30 transition transform active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Mulai Ujian Now</span>
                    </button>
                </form>

                <!-- FORM LOGIN GURU -->
                <form id="formLoginGuru" onsubmit="handleLoginGuru(event)" class="space-y-4 hidden">
                    <div class="text-center mb-4">
                        <h2 class="text-xl font-bold text-slate-800">Login Portal Guru</h2>
                        <p class="text-xs text-slate-500 mt-1">Akses khusus pengampu mata pelajaran PAI</p>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Kata Kunci Akses Guru</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input type="password" id="guruPassword" required placeholder="Masukkan Sandi Guru" class="w-full pl-10 pr-10 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-islamic-500 focus:bg-white text-sm outline-none transition">
                            <button type="button" onclick="togglePasswordVisibility('guruPassword', 'toggleIconGuru')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
                                <i id="toggleIconGuru" class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="w-full mt-4 py-3 px-4 bg-gradient-to-r from-slate-800 to-slate-900 hover:from-slate-900 hover:to-black text-white font-bold rounded-xl shadow-lg transition transform active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>Masuk Dashboard Guru</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- ================= VIEW 2: HALAMAN UJIAN SISWA ================= -->
        <div id="viewExam" class="hidden space-y-4 max-w-5xl mx-auto w-full">
            <!-- Student Header Banner -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-islamic-100 text-islamic-700 flex items-center justify-center font-bold text-lg">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                    <div>
                        <h3 id="examStudentName" class="font-bold text-slate-800 text-base">Nama Siswa</h3>
                        <div class="flex items-center space-x-2 text-xs text-slate-500">
                            <span id="examStudentClass" class="bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded">Kelas --</span>
                            <span>&bull;</span>
                            <span id="examQuestionTypeTag" class="text-islamic-700 font-medium">Sub-Tes: Pilihan Ganda</span>
                        </div>
                    </div>
                </div>

                <!-- Anti Cheat Badge & Timer -->
                <div class="flex items-center space-x-3 ml-auto">
                    <div id="cheatBadge" class="bg-amber-100 border border-amber-300 text-amber-800 text-xs px-2.5 py-1 rounded-full flex items-center space-x-1">
                        <i class="fa-solid fa-shield-halved text-amber-600"></i>
                        <span>Pelanggaran: <strong id="cheatCountText" class="text-amber-900">0/3</strong></span>
                    </div>

                    <div class="bg-slate-900 text-amber-300 px-4 py-2 rounded-xl font-mono text-sm font-bold flex items-center space-x-2 shadow-inner border border-amber-500/30">
                        <i class="fa-solid fa-clock text-amber-400 animate-pulse"></i>
                        <span id="examTimer">60:00</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
                <!-- Main Question Area -->
                <div class="lg:col-span-3 bg-white rounded-2xl shadow-md border border-slate-200 p-5 sm:p-6 flex flex-col justify-between min-h-[420px]">
                    <div>
                        <!-- Question Category & Number -->
                        <div class="flex justify-between items-center pb-3 border-b border-slate-100 mb-4">
                            <span id="questionNumBadge" class="bg-islamic-600 text-white text-xs font-bold px-3 py-1 rounded-lg">Soal #1</span>
                            <span id="questionTypeLabel" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Pilihan Ganda</span>
                        </div>

                        <!-- Question Text -->
                        <div id="questionText" class="text-slate-800 font-medium text-base sm:text-lg leading-relaxed mb-6">
                            Loading Soal...
                        </div>

                        <!-- Options Input Container -->
                        <div id="optionsContainer" class="space-y-3">
                            <!-- Injected dynamically based on question type -->
                        </div>
                    </div>

                    <!-- Bottom Nav Buttons -->
                    <div class="pt-6 mt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
                        <button id="btnPrev" onclick="navigateQuestion(-1)" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold rounded-xl transition flex items-center space-x-2">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Sebelumnya</span>
                        </button>

                        <button id="btnDoubt" onclick="toggleDoubt()" class="px-4 py-2.5 bg-amber-100 hover:bg-amber-200 text-amber-800 text-sm font-semibold rounded-xl transition flex items-center space-x-2">
                            <i class="fa-solid fa-flag"></i>
                            <span id="doubtBtnText">Ragu-Ragu</span>
                        </button>

                        <button id="btnNext" onclick="navigateQuestion(1)" class="px-5 py-2.5 bg-islamic-600 hover:bg-islamic-700 text-white text-sm font-semibold rounded-xl shadow-md transition flex items-center space-x-2 ml-auto">
                            <span>Selanjutnya</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>

                        <button id="btnFinishExam" onclick="confirmFinishExam()" class="hidden px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-xl shadow-md transition flex items-center space-x-2 ml-auto">
                            <i class="fa-solid fa-check-double"></i>
                            <span>Selesai Ujian</span>
                        </button>
                    </div>
                </div>

                <!-- Question Grid Navigation Side Panel -->
                <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-4 flex flex-col h-full">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center justify-between">
                        <span>Navigasi Soal</span>
                        <span id="answeredCounter" class="text-emerald-600 font-normal">0/30 Terjawab</span>
                    </h4>

                    <div id="questionGrid" class="grid grid-cols-5 gap-2 max-h-[300px] lg:max-h-none overflow-y-auto custom-scrollbar p-1">
                        <!-- 30 buttons rendered by JS -->
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 space-y-1">
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded bg-islamic-600 inline-block"></span>
                            <span>Sudah Dijawab</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded bg-amber-400 inline-block"></span>
                            <span>Ragu-Ragu</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded bg-slate-200 inline-block"></span>
                            <span>Belum Dijawab</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= VIEW 3: REKAPITULASI HASIL SISWA ================= -->
        <div id="viewResult" class="hidden w-full max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl overflow-hidden border border-slate-200 text-center p-6 sm:p-8">
            <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-4xl mx-auto mb-4 border-4 border-emerald-200">
                <i class="fa-solid fa-award"></i>
            </div>

            <h2 class="text-2xl font-bold text-slate-800">Ujian Berhasil Diselesaikan!</h2>
            <p class="text-xs text-slate-500 mt-1">Terima kasih telah mengerjakan ujian dengan jujur dan sungguh-sungguh.</p>

            <!-- Student Info Card -->
            <div class="my-6 bg-slate-50 rounded-xl p-4 border border-slate-200 text-left max-w-md mx-auto space-y-2 text-sm">
                <div class="flex justify-between border-b pb-1">
                    <span class="text-slate-500">Nama Siswa:</span>
                    <span id="resNama" class="font-bold text-slate-800">--</span>
                </div>
                <div class="flex justify-between border-b pb-1">
                    <span class="text-slate-500">Kelas:</span>
                    <span id="resKelas" class="font-bold text-slate-800">--</span>
                </div>
                <div class="flex justify-between border-b pb-1">
                    <span class="text-slate-500">Waktu Mengerjakan:</span>
                    <span id="resWaktu" class="font-bold text-slate-800">--</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-500">Catatan Pelanggaran:</span>
                    <span id="resViolations" class="font-bold text-emerald-600">0 kali (Sangat Jujur)</span>
                </div>
            </div>

            <!-- Score Display -->
            <div class="bg-gradient-to-r from-islamic-800 to-islamic-900 text-white rounded-2xl p-6 my-4 shadow-lg">
                <p class="text-xs text-amber-300 font-semibold uppercase tracking-widest">NILAI AKHIR ASESMEN</p>
                <div id="resScore" class="text-5xl font-black text-amber-400 my-2">0</div>
                <p id="resGradeStatus" class="text-xs text-emerald-200">Kategori: Sangat Baik</p>
            </div>

            <button onclick="logoutToHome()" class="mt-4 px-6 py-2.5 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded-xl transition">
                <i class="fa-solid fa-house me-2"></i>Kembali ke Halaman Utama
            </button>
        </div>

        <!-- ================= VIEW 4: DASHBOARD GURU ================= -->
        <div id="viewTeacher" class="hidden space-y-6 w-full">
            <!-- Top Navigation & Controls Bar -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-gauge-high text-islamic-600"></i>
                        <span>Dashboard Guru PAI - Junialdi, S.Pd, Gr.</span>
                    </h2>
                    <p class="text-xs text-slate-500">Kelola soal, token, data siswa, dan rekapitulasi nilai SDN Rawa Buaya 01</p>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="logoutToHome()" class="px-3.5 py-2 bg-red-50 text-red-600 hover:bg-red-100 text-xs font-bold rounded-xl transition border border-red-200">
                        <i class="fa-solid fa-power-off me-1"></i>Keluar
                    </button>
                </div>
            </div>

            <!-- Dashboard Sub-Tabs -->
            <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-2">
                <button id="tTab1" onclick="switchTeacherTab('results')" class="px-4 py-2 bg-islamic-600 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center space-x-2">
                    <i class="fa-solid fa-list-check"></i>
                    <span>Hasil &amp; Nilai Ujian</span>
                </button>
                <button id="tTab2" onclick="switchTeacherTab('questions')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center space-x-2">
                    <i class="fa-solid fa-file-pen"></i>
                    <span>Kelola &amp; Unggah Soal</span>
                </button>
                <button id="tTab3" onclick="switchTeacherTab('students')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center space-x-2">
                    <i class="fa-solid fa-users-gear"></i>
                    <span>Kelola Data Siswa</span>
                </button>
                <button id="tTab4" onclick="switchTeacherTab('settings')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center space-x-2">
                    <i class="fa-solid fa-key"></i>
                    <span>Pengaturan Token &amp; GAS</span>
                </button>
            </div>

            <!-- TEACHER SECTION 1: REKAP NILAI -->
            <div id="tSectionResults" class="space-y-4">
                <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-5">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <h3 class="font-bold text-slate-800 text-sm sm:text-base">Tabel Ringkasan Hasil Ujian Siswa</h3>
                        
