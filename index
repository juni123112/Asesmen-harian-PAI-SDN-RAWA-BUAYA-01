function simpanNilaiUjian(data) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  if (sheet.getLastRow() == 0) {
    sheet.appendRow(["Timestamp", "Nama Siswa", "Kelas", "Skor", "Pelanggaran", "Status"]);
  }
  sheet.appendRow([
    new Date(),
    data.nama,
    data.kelas,
    data.skor,
    data.pelanggaran,
    data.status
  ]);
  return { status: "success" };
}</pre>
